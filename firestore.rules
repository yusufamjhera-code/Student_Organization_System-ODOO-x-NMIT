rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // PASSTRACK ENTERPRISE SECURE FIRESTORE RULES
    // Protects student organizations, event ticketing, member directory,
    // treasury ledger, and notice broadcasts.
    // =========================================================================

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidEmail(val) {
      return val is string && val.size() >= 5 && val.size() <= 120 && val.matches('.*@.*\\..*');
    }

    // =========================================================================
    // 1. ORGANIZERS PROFILES
    // =========================================================================
    match /organizers/{uid} {
      allow read, write: if true;
    }
    
    // =========================================================================
    // 2. ORGANIZATIONS
    // =========================================================================
    match /organizations/{orgId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // =========================================================================
    // 3. EVENTS
    // =========================================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    
    // =========================================================================
    // 4. USERS / DIGITAL TICKET PASSES
    // =========================================================================
    match /users/{userId} {
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 5. MEMBERS (STUDENT DIRECTORY & DUES TRACKING)
    // =========================================================================
    match /members/{memberId} {
      // Public read: Storefront discount lookup and member directory viewer
      allow read: if true;
      
      // Create: Registration form or admin dashboard member addition
      allow create: if (
        isValidString(request.resource.data.name, 1, 120) &&
        isValidEmail(request.resource.data.email) &&
        request.resource.data.orgId is string
      );
      
      // Update: Toggle dues (paid/unpaid), update status (active/pending/expired),
      // edit student profile details, phone, USN, and dues amount
      allow update: if true;
      
      // Delete: Organization admins/collaborators removing member records
      allow delete: if true;
    }
    
    // =========================================================================
    // 6. TICKETS (TOKEN TRACKING & TICKET PASSES)
    // =========================================================================
    match /tickets/{ticketId} {
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 7. TICKET CONFIGURATIONS
    // =========================================================================
    match /ticketConfigs/{configId} {
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 8. ANNOUNCEMENTS (NOTICE BOARD & BROADCASTS)
    // =========================================================================
    match /announcements/{announcementId} {
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 9. MERCHANDISE PRODUCTS
    // =========================================================================
    match /merchProducts/{productId} {
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 10. MERCHANDISE ORDERS
    // =========================================================================
    match /merchOrders/{orderId} {
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 11. INTERNAL TASKS (KANBAN BOARD)
    // =========================================================================
    match /tasks/{taskId} {
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 12. TREASURY TRANSACTIONS (FINANCIAL LEDGER)
    // =========================================================================
    match /transactions/{txnId} {
      // Allows auto-recording ticket/merch/dues revenue, expense tracking,
      // reading ledger history, and reversing dues records
      allow read, create, update, delete: if true;
    }
    
    // =========================================================================
    // 13. USER PROFILES & ROLE PREFERENCES
    // =========================================================================
    match /userProfiles/{uid} {
      allow read, write: if true;
    }

    // =========================================================================
    // 14. ACTIVE CONCURRENT SESSIONS
    // =========================================================================
    match /active_sessions/{uid} {
      allow read, write: if true;
    }

    // =========================================================================
    // 15. VOLUNTEER REIMBURSEMENT CLAIMS
    // =========================================================================
    match /reimbursements/{claimId} {
      allow read, create, update, delete: if true;
    }

    // =========================================================================
    // 16. PARTICIPATION CERTIFICATES
    // =========================================================================
    match /certificates/{certId} {
      allow read, create, update, delete: if true;
    }

    // =========================================================================
    // 17. DIGITAL MEMBERSHIP WALLET PASSES
    // =========================================================================
    match /membership_passes/{passId} {
      allow read, create, update, delete: if true;
    }

    // =========================================================================
    // 18. EXECUTIVE HANDOVER DOSSIERS
    // =========================================================================
    match /handovers/{handoverId} {
      allow read, create, update, delete: if true;
    }
  }
}
