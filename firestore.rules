rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== EXISTING COLLECTIONS =====
    
    match /organizers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    match /events/{eventId} {
      allow read: if true; 
      allow create: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      // ✅ FIX: Allow public 'update' so ticket buyers can increment seatsSold
      allow update: if true;
      allow delete: if request.auth != null;
    }
    
    // ✅ FIX: Allow public 'update' so unauthenticated Staff can scan/mark tokens as used
    // ✅ FIX: Allow public 'create' so users can buy tickets
    match /users/{userId} {
      allow read, update, create: if true; 
      allow delete: if request.auth != null;
    }
    
    // ===== NEW COLLECTIONS =====
    
    // ✅ FIX: Allow public 'read' so the "Join as Member" page can fetch the organization name and fees
    match /organizations/{orgId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    
    match /members/{memberId} {
      allow read, create: if true; 
      allow update, delete: if request.auth != null;
    }
    
    // ✅ FIX: Allow public 'update' so Staff can scan tickets at the door
    match /tickets/{ticketId} {
      allow read, create, update: if true; 
      allow delete: if request.auth != null;
    }
    
    match /ticketConfigs/{configId} {
      allow read: if true; 
      allow create, update, delete: if request.auth != null;
    }
    
    match /announcements/{announcementId} {
      allow read: if true; 
      allow create, update, delete: if request.auth != null;
    }
    
    match /merchProducts/{productId} {
      allow read: if true; 
      allow create, update, delete: if request.auth != null;
    }
    
    match /merchOrders/{orderId} {
      allow read, create: if true; 
      allow update, delete: if request.auth != null;
    }
    
    match /tasks/{taskId} {
      allow read, create, update, delete: if request.auth != null;
    }
    
    // ✅ FIX: Allow public 'create' so the ticket purchase transaction can record income
    match /transactions/{txnId} {
      allow read, update, delete: if request.auth != null;
      allow create: if true;
    }
  }
}
