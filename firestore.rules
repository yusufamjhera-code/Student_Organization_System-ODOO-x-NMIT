rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // PASSTRACK SECURE FIRESTORE RULES
    // Protects against NoSQL injection, unauthorized privilege escalation,
    // tampering with prices/inventory, and arbitrary document writes.
    // =========================================================================

    // --- Core Authentication Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isNonAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // --- Validation Helpers ---
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidEmail(val) {
      return val is string && val.size() >= 5 && val.size() <= 120 && val.matches('.*@.*\\..*');
    }

    // =========================================================================
    // 1. ORGANIZERS PROFILES
    // =========================================================================
    match /organizers/{uid} {
      allow read, write: if isOwner(uid);
    }
    
    // =========================================================================
    // 2. ORGANIZATIONS
    // =========================================================================
    match /organizations/{orgId} {
      // Public read: Needed by public store, member registration, and tickets
      allow read: if true;
      
      // Organizers manage their organization
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        request.resource.data.ownerId == request.auth.uid
      );
    }

    // =========================================================================
    // 3. EVENTS
    // =========================================================================
    match /events/{eventId} {
      // Public read: Storefront, attendee pass viewer, door scanner
      allow read: if true;
      
      // Event creation restricted to authenticated organizers
      allow create: if isNonAnonymous();
      
      // Update: Organizer has full access;
      // Public ticket buyers may ONLY increment seatsSold in ticketConfig
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketConfig', 'seatsSold', 'updatedAt']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ticketConfig']) ||
          request.resource.data.ticketConfig.seatsSold is number
        )
      );
      
      allow delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 4. USERS / DIGITAL TICKET PASSES
    // =========================================================================
    match /users/{userId} {
      // Public read: Attendee pass viewer & door QR scanner
      allow read: if true;
      
      // Public create: Attendees generate passes upon payment/booking
      allow create: if (
        isValidString(request.resource.data.name, 2, 100) &&
        isValidEmail(request.resource.data.contact) &&
        request.resource.data.qrToken is string &&
        request.resource.data.eventDocId is string &&
        request.resource.data.paymentStatus in ['paid', 'free', 'pending']
      );
      
      // Update: Organizers have full edit rights;
      // Gate scanner staff can update check-in permissions & timestamps
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'permissions', 'scannedAt', 'scannedBy', 'updatedAt', 'checkInTime'
        ])
      );
      
      allow delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 5. MEMBERS (STUDENT DIRECTORY)
    // =========================================================================
    match /members/{memberId} {
      // Public read: Member discount verification in ticket storefront & merch
      allow read: if true;
      
      // Public create: Prospective members join via public registration form
      allow create: if (
        isValidString(request.resource.data.name, 2, 100) &&
        isValidEmail(request.resource.data.email) &&
        request.resource.data.orgId is string &&
        request.resource.data.membershipStatus in ['pending', 'active']
      );
      
      // Update: Organizers have full administrative access;
      // Members can activate status upon dues payment verification
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'membershipStatus', 'duesPaid', 'duesPaidAt', 'paymentMethod', 'paymentRef', 'updatedAt'
        ]) &&
        request.resource.data.duesPaid == true &&
        request.resource.data.membershipStatus == 'active'
      );
      
      allow delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 6. TICKETS (TOKEN TRACKING)
    // =========================================================================
    match /tickets/{ticketId} {
      allow read, create: if true;
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedAt', 'updatedAt'])
      );
      allow delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 7. TICKET CONFIGURATIONS
    // =========================================================================
    match /ticketConfigs/{configId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 8. ANNOUNCEMENTS (NOTICE BOARD)
    // =========================================================================
    match /announcements/{announcementId} {
      // Public read: Notice board public viewer
      allow read: if true;
      
      // Organizers publish announcements; permits structured initial seed notices
      allow create: if isAuthenticated() || (
        request.resource.data.orgId is string &&
        isValidString(request.resource.data.title, 2, 120) &&
        request.resource.data.content is string
      );
      
      allow update, delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 9. MERCHANDISE PRODUCTS
    // =========================================================================
    match /merchProducts/{productId} {
      // Public read: Storefront catalog
      allow read: if true;
      
      // Stock decrement: Storefront checkout can update inventory stock sizes and totalSold
      allow update: if isAuthenticated() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sizes', 'totalSold', 'updatedAt']) &&
        request.resource.data.totalSold is number &&
        request.resource.data.totalSold >= resource.data.totalSold
      );
      
      allow create, delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 10. MERCHANDISE ORDERS
    // =========================================================================
    match /merchOrders/{orderId} {
      // Public read: Allows shoppers to view order history & pickup status by email
      allow read: if true;
      
      // Public create: Shoppers place orders through storefront with strict field validation
      allow create: if (
        request.resource.data.orgId is string &&
        request.resource.data.productId is string &&
        isValidString(request.resource.data.buyerName, 2, 100) &&
        isValidEmail(request.resource.data.buyerEmail) &&
        request.resource.data.quantity is int &&
        request.resource.data.quantity > 0 &&
        request.resource.data.totalPrice is number &&
        request.resource.data.totalPrice >= 0 &&
        request.resource.data.paymentStatus in ['paid', 'free', 'pending'] &&
        request.resource.data.fulfillmentStatus in ['ordered', 'ready', 'collected']
      );
      
      // Organizers manage and fulfill orders
      allow update, delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 11. INTERNAL TASKS (KANBAN BOARD)
    // =========================================================================
    match /tasks/{taskId} {
      // Internal operations: Only authenticated organizers and team members
      allow read, create, update, delete: if isAuthenticated();
    }
    
    // =========================================================================
    // 12. TREASURY TRANSACTIONS (LEDGER)
    // =========================================================================
    match /transactions/{txnId} {
      // Public create: Ticket and merch checkout auto-record revenue
      // Strictly guarded against arbitrary expenses or negative amounts
      allow create: if isAuthenticated() || (
        request.resource.data.type == 'income' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.category in ['tickets', 'merchandise', 'dues'] &&
        request.resource.data.orgId is string
      );
      
      // Financial ledger is read/edit restricted to authenticated club managers
      allow read, update, delete: if isAuthenticated();
    }
  }
}
